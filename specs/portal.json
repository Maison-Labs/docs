{"openapi":"3.0.3","info":{"title":"Maison Apps Portal","version":"1.0.0","description":"The common auth layer for Maison standalone apps: sign-in and sessions, JWT issuance and JWKS, per-user app access, and centrally managed machine credentials (API keys and OAuth client-credentials) scoped to one or many apps."},"servers":[{"url":"http://localhost:8180","description":"Local development"}],"tags":[{"name":"Authentication","description":"User sign-in, tokens and key discovery"},{"name":"Apps & Access","description":"The app catalog and per-user access grants"},{"name":"Users","description":"User provisioning and listing (admin)"},{"name":"Machine Credentials","description":"API keys and OAuth clients for services calling Maison apps"}],"paths":{"/api/auth/sign-in/email":{"post":{"tags":["Authentication"],"operationId":"signInEmail","summary":"Sign in with email and password","description":"Establishes a session (cookie). The session is the long-lived credential — exchange it for short-lived JWTs at /api/auth/token.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["email","password"],"properties":{"email":{"type":"string","format":"email"},"password":{"type":"string","format":"password"}}},"example":{"email":"user@example.com","password":"hunter2hunter2"}}}},"responses":{"200":{"description":"Signed in; session cookie set","content":{"application/json":{"schema":{"type":"object","properties":{"token":{"type":"string","description":"Session token"},"user":{"$ref":"#/components/schemas/User"}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"}}}},"/api/auth/token":{"get":{"tags":["Authentication"],"operationId":"mintToken","summary":"Mint a JWT from the current session","description":"Returns a 15-minute JWT for the signed-in user. Claims include role and apps (granted app slugs). Call again whenever a token expires; each fresh token picks up access changes.","security":[{"sessionCookie":[]}],"responses":{"200":{"description":"A signed JWT","content":{"application/json":{"schema":{"type":"object","properties":{"token":{"type":"string"}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"}}}},"/.well-known/jwks.json":{"get":{"tags":["Authentication"],"operationId":"getJwks","summary":"Public signing keys (JWKS)","description":"The key set for validating every portal-issued JWT (user and machine). Also served at /api/auth/jwks.","responses":{"200":{"description":"JSON Web Key Set","content":{"application/json":{"schema":{"type":"object","properties":{"keys":{"type":"array","items":{"type":"object"}}}},"example":{"keys":[{"alg":"EdDSA","crv":"Ed25519","kty":"OKP","x":"…","kid":"…"}]}}}}}}},"/api/v1/oauth/token":{"post":{"tags":["Machine Credentials"],"operationId":"clientCredentialsToken","summary":"Exchange client credentials for a machine JWT","description":"OAuth 2.0 client_credentials grant. Returns a 1-hour JWT carrying the credential's app scopes; target apps can validate it locally against the JWKS.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["grant_type","client_id","client_secret"],"properties":{"grant_type":{"type":"string","enum":["client_credentials"]},"client_id":{"type":"string"},"client_secret":{"type":"string"}}},"example":{"grant_type":"client_credentials","client_id":"mc_…","client_secret":"mcs_…"}}}},"responses":{"200":{"description":"Access token","content":{"application/json":{"schema":{"type":"object","properties":{"access_token":{"type":"string"},"token_type":{"type":"string","enum":["Bearer"]},"expires_in":{"type":"integer","example":3600}}}}}},"401":{"description":"Unknown or revoked client","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}}},"example":{"error":"invalid_client"}}}}}}},"/api/v1/validate-credential":{"post":{"tags":["Machine Credentials"],"operationId":"validateCredential","summary":"Validate an incoming Authorization header","description":"The single endpoint downstream apps call to validate a credential against an app slug. Accepts raw API keys (mk_…) and portal-issued JWTs (user or machine). No additional auth — possession of the credential is what is being verified.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["authorization","app"],"properties":{"authorization":{"type":"string","description":"The full Authorization header value, or the bare credential"},"app":{"type":"string","description":"Slug of the app receiving the request"}}},"example":{"authorization":"Bearer mk_…","app":"table"}}}},"responses":{"200":{"description":"Credential is valid for the app","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValidationResult"}}}},"401":{"description":"Invalid, revoked or out-of-scope credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValidationResult"},"example":{"valid":false,"reason":"out_of_scope"}}}}}}},"/api/v1/my-apps":{"get":{"tags":["Apps & Access"],"operationId":"myApps","summary":"List the apps the signed-in user may open","security":[{"sessionCookie":[]}],"responses":{"200":{"description":"Accessible apps","content":{"application/json":{"schema":{"type":"object","properties":{"apps":{"type":"array","items":{"$ref":"#/components/schemas/App"}}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"}}}},"/api/v1/list-apps":{"get":{"tags":["Apps & Access"],"operationId":"listApps","summary":"List the full app catalog (admin)","security":[{"sessionCookie":[]}],"responses":{"200":{"description":"All registered apps","content":{"application/json":{"schema":{"type":"object","properties":{"apps":{"type":"array","items":{"$ref":"#/components/schemas/App"}}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"}}}},"/api/v1/register-app":{"post":{"tags":["Apps & Access"],"operationId":"registerApp","summary":"Add an app to the catalog (admin)","security":[{"sessionCookie":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["slug","name","url"],"properties":{"slug":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"},"name":{"type":"string"},"description":{"type":"string"},"url":{"type":"string","format":"uri"},"icon":{"type":"string","description":"Emoji"}}},"example":{"slug":"table","name":"Table Management","url":"https://table.maison-labs.com","icon":"🍽️"}}}},"responses":{"201":{"description":"Registered","content":{"application/json":{"schema":{"type":"object","properties":{"app":{"$ref":"#/components/schemas/App"}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"409":{"$ref":"#/components/responses/Conflict"}}}},"/api/v1/update-app":{"post":{"tags":["Apps & Access"],"operationId":"updateApp","summary":"Update a catalog entry (admin)","security":[{"sessionCookie":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["slug"],"properties":{"slug":{"type":"string","description":"Immutable identifier of the app"},"name":{"type":"string"},"description":{"type":"string"},"url":{"type":"string","format":"uri"},"icon":{"type":"string"}}}}}},"responses":{"200":{"description":"Updated","content":{"application/json":{"schema":{"type":"object","properties":{"app":{"$ref":"#/components/schemas/App"}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"}}}},"/api/v1/remove-app":{"post":{"tags":["Apps & Access"],"operationId":"removeApp","summary":"Remove an app from the catalog (admin)","description":"Also removes all access grants to it (cascade).","security":[{"sessionCookie":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["slug"],"properties":{"slug":{"type":"string"}}}}}},"responses":{"200":{"$ref":"#/components/responses/Ok"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"}}}},"/api/v1/grant-app-access":{"post":{"tags":["Apps & Access"],"operationId":"grantAppAccess","summary":"Grant a user access to an app (admin)","description":"Takes effect on the user's next token refresh (≤15 minutes).","security":[{"sessionCookie":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AccessChange"},"example":{"email":"user@example.com","appSlug":"table"}}}},"responses":{"200":{"$ref":"#/components/responses/Ok"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"}}}},"/api/v1/revoke-app-access":{"post":{"tags":["Apps & Access"],"operationId":"revokeAppAccess","summary":"Revoke a user's access to an app (admin)","description":"Takes effect on the next token refresh — already-issued JWTs stay valid until they expire (≤15 minutes).","security":[{"sessionCookie":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AccessChange"}}}},"responses":{"200":{"$ref":"#/components/responses/Ok"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"}}}},"/api/v1/list-users":{"get":{"tags":["Users"],"operationId":"listUsers","summary":"List users with their granted apps (admin)","security":[{"sessionCookie":[]}],"parameters":[{"name":"query","in":"query","required":false,"schema":{"type":"string"},"description":"Filter by name or email substring"}],"responses":{"200":{"description":"Users","content":{"application/json":{"schema":{"type":"object","properties":{"users":{"type":"array","items":{"$ref":"#/components/schemas/User"}}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"}}}},"/api/v1/create-user":{"post":{"tags":["Users"],"operationId":"createUser","summary":"Provision a user (admin)","description":"Public sign-up is disabled — this is the only way accounts are created. Optionally grants initial app access.","security":[{"sessionCookie":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["name","email","password"],"properties":{"name":{"type":"string"},"email":{"type":"string","format":"email"},"password":{"type":"string","minLength":8},"role":{"type":"string","enum":["user","admin"],"default":"user"},"apps":{"type":"array","items":{"type":"string"},"description":"App slugs to grant immediately"}}},"example":{"name":"Front Desk","email":"frontdesk@example.com","password":"s3cure-pass","apps":["table"]}}}},"responses":{"201":{"description":"Created","content":{"application/json":{"schema":{"type":"object","properties":{"user":{"$ref":"#/components/schemas/User"},"grantedApps":{"type":"array","items":{"type":"string"}}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"409":{"$ref":"#/components/responses/Conflict"}}}},"/api/v1/create-api-key":{"post":{"tags":["Machine Credentials"],"operationId":"createApiKey","summary":"Create a machine API key (admin)","description":"The raw key appears in this response only — store it immediately.","security":[{"sessionCookie":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CredentialRequest"},"example":{"name":"maison-agent","apps":["table","pms"]}}}},"responses":{"201":{"description":"Created; raw key shown once","content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"name":{"type":"string"},"scopes":{"type":"array","items":{"type":"string"}},"apiKey":{"type":"string","example":"mk_…"}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"}}}},"/api/v1/create-oauth-client":{"post":{"tags":["Machine Credentials"],"operationId":"createOauthClient","summary":"Create an OAuth client-credentials pair (admin)","description":"The raw secret appears in this response only — store it immediately.","security":[{"sessionCookie":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CredentialRequest"}}}},"responses":{"201":{"description":"Created; secret shown once","content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"name":{"type":"string"},"scopes":{"type":"array","items":{"type":"string"}},"clientId":{"type":"string","example":"mc_…"},"clientSecret":{"type":"string","example":"mcs_…"}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"}}}},"/api/v1/list-credentials":{"get":{"tags":["Machine Credentials"],"operationId":"listCredentials","summary":"List machine credentials without secrets (admin)","security":[{"sessionCookie":[]}],"responses":{"200":{"description":"Credentials","content":{"application/json":{"schema":{"type":"object","properties":{"credentials":{"type":"array","items":{"$ref":"#/components/schemas/Credential"}}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"}}}},"/api/v1/update-credential-scopes":{"post":{"tags":["Machine Credentials"],"operationId":"updateCredentialScopes","summary":"Replace a credential's app scopes (admin)","security":[{"sessionCookie":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["id","apps"],"properties":{"id":{"type":"string","format":"uuid"},"apps":{"type":"array","items":{"type":"string"},"minItems":1}}}}}},"responses":{"200":{"$ref":"#/components/responses/Ok"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"}}}},"/api/v1/revoke-credential":{"post":{"tags":["Machine Credentials"],"operationId":"revokeCredential","summary":"Revoke a machine credential (admin)","description":"API keys stop validating immediately; outstanding OAuth JWTs stay valid until expiry (≤1 hour).","security":[{"sessionCookie":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["id"],"properties":{"id":{"type":"string","format":"uuid"}}}}}},"responses":{"200":{"$ref":"#/components/responses/Ok"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"}}}}},"components":{"securitySchemes":{"sessionCookie":{"type":"apiKey","in":"cookie","name":"better-auth.session_token","description":"Session cookie set by sign-in. Admin endpoints require the admin role."},"bearerToken":{"type":"http","scheme":"bearer","bearerFormat":"JWT","description":"A portal-issued JWT (user or machine) — or a raw API key (mk_…)."}},"responses":{"Ok":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"}}},"example":{"ok":true}}}},"Unauthorized":{"description":"Not signed in / invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"Forbidden":{"description":"Admin role required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"NotFound":{"description":"No such entity","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"Conflict":{"description":"Already exists","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}},"schemas":{"Error":{"type":"object","properties":{"error":{"type":"string"}},"example":{"error":"Admin role required"}},"App":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"slug":{"type":"string"},"name":{"type":"string"},"description":{"type":"string","nullable":true},"url":{"type":"string","format":"uri"},"icon":{"type":"string","nullable":true},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"}}},"User":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"email":{"type":"string","format":"email"},"role":{"type":"string","enum":["user","admin"],"nullable":true},"banned":{"type":"boolean","nullable":true},"apps":{"type":"array","items":{"type":"string"},"description":"Granted app slugs (present in list-users)"}}},"AccessChange":{"type":"object","required":["email","appSlug"],"properties":{"email":{"type":"string","format":"email"},"appSlug":{"type":"string"}}},"CredentialRequest":{"type":"object","required":["name","apps"],"properties":{"name":{"type":"string","description":"Human-readable name of the calling service"},"apps":{"type":"array","items":{"type":"string"},"minItems":1,"description":"App slugs the credential may access; [\"*\"] scopes it to every app"}}},"Credential":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"name":{"type":"string"},"type":{"type":"string","enum":["api_key","oauth_client"]},"clientId":{"type":"string","nullable":true},"scopes":{"type":"array","items":{"type":"string"}},"createdAt":{"type":"string","format":"date-time"},"lastUsedAt":{"type":"string","format":"date-time","nullable":true},"revokedAt":{"type":"string","format":"date-time","nullable":true}}},"ValidationResult":{"type":"object","properties":{"valid":{"type":"boolean"},"reason":{"type":"string","description":"Present when valid=false","enum":["empty_credential","unknown_or_revoked_api_key","out_of_scope","invalid_token"]},"principal":{"type":"object","description":"Present when valid=true","properties":{"kind":{"type":"string","enum":["machine","user"]},"credentialType":{"type":"string","enum":["api_key","oauth_client"]},"id":{"type":"string"},"name":{"type":"string"},"scopes":{"type":"array","items":{"type":"string"}}}}}}}}}