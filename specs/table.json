ormat":"date-time"},"cancelledAt":{"type":"string","format":"date-time","nullable":true},"notes":{"type":"string","nullable":true},"lines":{"type":"array","items":{"type":"object"}},"guest":{"type":"object","nullable":true}}}}}}}}}},"/reservations/{id}":{"get":{"tags":["Reservations"],"operationId":"getReservation","summary":"One reservation with lines and guest","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"The reservation","content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"clientId":{"type":"string","format":"uuid"},"propertyId":{"type":"string","format":"uuid"},"status":{"type":"string","enum":["inquiry","quoted","held","confirmed","modified","cancelled","no_show","completed"]},"sourceChannel":{"type":"string"},"confirmationNumber":{"type":"string","description":"6-char phone-sayable code, e.g. RK8A2F"},"bookedAt":{"type":"string","format":"date-time"},"cancelledAt":{"type":"string","format":"date-time","nullable":true},"notes":{"type":"string","nullable":true},"lines":{"type":"array","items":{"type":"object"}},"guest":{"type":"object","nullable":true}}}}}},"404":{"description":"Not found"}}},"patch":{"tags":["Reservations"],"operationId":"modifyReservation","summary":"Modify time, party or notes — availability re-checked when the slot changes","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Modified","content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"clientId":{"type":"string","format":"uuid"},"propertyId":{"type":"string","format":"uuid"},"status":{"type":"string","enum":["inquiry","quoted","held","confirmed","modified","cancelled","no_show","completed"]},"sourceChannel":{"type":"string"}